COMPOSE_PROJECT_NAME=pgha-demo

# Host ports. Change these if a local port is already busy.
WRITE_PORT=15000
READ_PORT=15001
HAPROXY_STATS_PORT=17000
PGBOUNCER_WRITE_PORT=16432
PGBOUNCER_READ_PORT=16433

# Demo tuning. Override when you want a shorter or longer class run.
PGBENCH_TIME=20
PGBENCH_SCALE=5
DEMO_PAUSE=1
